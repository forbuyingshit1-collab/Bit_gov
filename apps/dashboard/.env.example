# PIN values must be generated and stored only in Vercel's encrypted environment variables.
DASHBOARD_PIN_SALT=
DASHBOARD_PIN_HASH=
SESSION_SECRET=
# Shared only between the Dashboard server and API Worker for review decisions.
BIT_GOV_REVIEW_TOKEN=
